# Supabase project URL and public (browser-safe) publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection strings (Prisma). Transaction-mode pooler for the app,
# session-mode pooler for migrations.
DATABASE_URL=
DIRECT_URL=

# Supabase service-role key — bypasses RLS/storage policies. Server-only:
# never prefix with NEXT_PUBLIC_ or import it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=
